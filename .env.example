# ============================================================
# P2P Gossip Mesh — Environment Configuration
# ============================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# docker compose will automatically load variables from .env
# ============================================================

# ─── Local LLM Model ────────────────────────────────────────
# The Ollama model to download and use for AI summarization.
# The model is pulled automatically on first boot.
# Swap to any Ollama-compatible model name:
#   llama3.2:1b   (fastest, ~700MB, default)
#   gemma2:2b     (slightly smarter, ~1.6GB)
#   phi3:mini     (Microsoft, ~2.3GB)
#   llama3.1:8b   (best quality, ~4.7GB, needs 8GB RAM)
OLLAMA_MODEL=llama3.2:1b

# ─── Node Ports ─────────────────────────────────────────────
# External port mappings for each P2P node.
# Change these if the defaults conflict with running services.
ALPHA_P2P_PORT=8080
ALPHA_METRICS_PORT=8090

BETA_P2P_PORT=8081
BETA_METRICS_PORT=8091

GAMMA_P2P_PORT=8082
GAMMA_METRICS_PORT=8092

# ─── AI Service ─────────────────────────────────────────────
AI_SERVICE_PORT=8001

# ─── Ollama ─────────────────────────────────────────────────
OLLAMA_PORT=11434

# ─── Visualizer ─────────────────────────────────────────────
VISUALIZER_PORT=5173

# ─── Gossip Protocol Tuning ─────────────────────────────────
# Increase capacity for high-traffic networks, decrease for demos
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_RATE=5
